# Sardaar G Construction Ltd. - Netlify Environment Variables
#
# Add these in Netlify:
# Site configuration > Environment variables
#
# Do not commit real secret values. Keep this file as a template only.

# Public site URL
NEXT_PUBLIC_SITE_URL=https://sardaar.netlify.app

# Supabase public keys
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Supabase server-only key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# Resend email notifications
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=Sardaar G Construction <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=YOUR_ADMIN_EMAIL

# Security / rate limit secrets
RATE_LIMIT_SALT=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_TEXT
CRON_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_TEXT

# SEO indexing
# Keep false while testing. Change to true only when the real production domain is ready.
SITE_INDEXABLE=false
